{
    "name": "creatix/app-version-manager",
    "description": "Enterprise-ready Laravel package for mobile app version policy enforcement, forced/optional update gates (HTTP 426), in-app update checks, and automated App Store & Google Play Store release sync.",
    "type": "library",
    "keywords": [
        "creatix",
        "laravel",
        "laravel-package",
        "app-version",
        "app-version-manager",
        "app-versioning",
        "mobile-app",
        "force-update",
        "forced-update",
        "optional-update",
        "in-app-update",
        "version-checker",
        "version-gate",
        "update-gate",
        "mobile-api",
        "upgrade-required",
        "http-426",
        "ios",
        "android",
        "flutter",
        "react-native",
        "app-store-connect",
        "play-store",
        "semver",
        "api-versioning"
    ],
    "homepage": "https://github.com/Creatix-Infotech/app-version-manager",
    "support": {
        "source": "https://github.com/Creatix-Infotech/app-version-manager",
        "docs": "https://github.com/Creatix-Infotech/app-version-manager#readme"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Creatix Infotech",
            "email": "hello@creatixinfotech.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4|^8.5",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "firebase/php-jwt": "^6.10|^7.0",
        "google/auth": "^1.30"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Creatix\\AppVersionManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Creatix\\AppVersionManager\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Creatix\\AppVersionManager\\AppVersionManagerServiceProvider"
            ],
            "aliases": {
                "AppVersion": "Creatix\\AppVersionManager\\Facades\\AppVersion"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}