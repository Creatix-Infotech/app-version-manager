{
    "name": "creatix/app-version-manager",
    "description": "Mobile app version policy enforcement, forced/optional update gates, and automated store sync for Laravel.",
    "keywords": [
        "creatix",
        "laravel",
        "app-version",
        "mobile-updates",
        "force-update",
        "app-store-connect",
        "google-play"
    ],
    "homepage": "https://github.com/creatix/app-version-manager",
    "license": "MIT",
    "authors": [
        {
            "name": "Creatix Infotech",
            "email": "info@creatixinfotech.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4|^8.5",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "firebase/php-jwt": "^6.10",
        "google/auth": "^1.30"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Creatix\\AppVersionManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Creatix\\AppVersionManager\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Creatix\\AppVersionManager\\AppVersionManagerServiceProvider"
            ],
            "aliases": {
                "AppVersion": "Creatix\\AppVersionManager\\Facades\\AppVersion"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

